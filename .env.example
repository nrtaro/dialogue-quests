# Copy to .env.local. Never use NEXT_PUBLIC_ for a key.
# AI_PROVIDER: mock (no AI) / workers-ai (Cloudflare free tier, the target) / openai
AI_PROVIDER=mock

# Cloudflare Workers AI (free tier). Create an API token with "Workers AI: Read" only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
# Daily free allocation (neurons) and the amount reserved for one play before it may start.
AI_DAILY_NEURONS=10000
AI_PLAY_RESERVE=900

# OpenAI (paid API; not the current plan)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Show prototype contents in the list (development only)
ENABLE_PROTOTYPES=
